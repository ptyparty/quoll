import { applyCoupon, type Coupon } from "./coupons.ts";
import type { Cents } from "./money.ts";

export type Line = { sku: string; unitPrice: Cents; quantity: number };

export function subtotal(lines: Line[]): Cents {
  return lines.reduce((sum, line) => sum + line.unitPrice * line.quantity, 0);
}

export function total(lines: Line[], coupon?: Coupon): Cents {
  const before = subtotal(lines);
  return coupon ? applyCoupon(coupon, before) : before;
}
